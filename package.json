{
	"name": "tagafinity",
	"version": "0.3.3",
	"description": "Suggest and manage tags using semantic similarity between notes.",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"lint": "eslint src/",
		"test": "vitest run",
		"test:watch": "vitest watch",
		"test:coverage": "vitest run --coverage",
		"typecheck": "tsc -noEmit -skipLibCheck",
		"release": "bash scripts/release.sh"
	},
	"keywords": [
		"obsidian",
		"obsidian-plugin"
	],
	"author": "Michael Filbin",
	"license": "MIT",
	"devDependencies": {
		"@eslint/js": "^9.30.1",
		"@types/node": "^22.0.0",
		"builtin-modules": "^4.0.0",
		"esbuild": "^0.24.0",
		"eslint": "^10.13.0",
		"eslint-plugin-obsidianmd": "^0.4.2",
		"globals": "^14.0.0",
		"jiti": "^2.7.0",
		"obsidian": "latest",
		"tslib": "^2.7.0",
		"typescript": "~5.6.0",
		"typescript-eslint": "^8.35.1",
		"vitest": "^3.0.0"
	},
	"dependencies": {
		"@huggingface/transformers": "^4.3.1"
	},
	"type": "module"
}
